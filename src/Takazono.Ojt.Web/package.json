    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "aspida": "^1.14.0",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "notistack": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-intl": "^10.1.16",
    "react-redux": "^9.3.0",
