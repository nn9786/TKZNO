    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:prettier": "npm run lint:prettier -- --write",
    "preview": "vite preview",
    "api": "rimraf src/api && openapi2aspida",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
